// Default Solilog keymap. Override in ~/.config/solilog/keymap.json (same format).
//
// Contexts, outermost first:
//   Workspace            the whole window
//   Sidebar              the sidebar has focus
//   IssueList            the issue list has focus
//   Archive              the archive has focus (it replaces the issue list)
//   IssueDetail          an open issue (it replaces the issue list); its
//                        title and description fields are TextInputs in it
//   Checklist            the open issue's checklist, in IssueDetail; each
//                        item is a ChecklistItem holding a TextInput
//   NewIssue > TextInput the new-issue input has focus
//   ImagePreview         an image attachment shown over the window
//   Picker               any popup list (command palette, status picker)
//   TextInput            any text field; multi-line ones are also `multiline`
[
  {
    "bindings": {
      "cmd-q": "workspace::Quit"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-k": "command_palette::Toggle",
      "cmd-shift-p": "command_palette::Toggle",
      "cmd-n": "issue::New",
      "cmd-b": "workspace::ToggleSidebar",
      "cmd-s": "view::Save",
      "cmd-shift-s": "view::SaveAs"
    }
  },
  {
    "context": "IssueList",
    "bindings": {
      "c": "issue::New",
      "enter": "issue::Open",
      "e": "issue::Edit",
      "s": "issue::SetStatus",
      "l": "issue::AddLabel",
      "shift-l": "issue::RemoveLabel",
      "p": "issue::AddToProject",
      "shift-p": "issue::RemoveFromProject",
      "v": "view::Open",
      "shift-v": "view::ShowAll",
      "g p": "view::OpenProject",
      "g l": "view::OpenLabel",
      "f l": "filter::ToggleLabel",
      "f x": "filter::ExcludeLabel",
      "f p": "filter::ToggleProject",
      "f s": "filter::ToggleStatus",
      "f o": "filter::ToggleOpenOnly",
      "f n": "filter::ToggleNoProject",
      "f c": "filter::Clear",
      "f a": "filter::AllStatuses",
      "f r": "view::Revert",
      "h": "workspace::FocusSidebar",
      "left": "workspace::FocusSidebar",
      "j": "issue_list::SelectNext",
      "k": "issue_list::SelectPrevious",
      "down": "issue_list::SelectNext",
      "up": "issue_list::SelectPrevious",
      "g g": "issue_list::SelectFirst",
      "shift-g": "issue_list::SelectLast",
      "home": "issue_list::SelectFirst",
      "end": "issue_list::SelectLast",
      "x": "issue_list::ToggleSelected",
      "cmd-a": "issue_list::SelectAll",
      "escape": "issue_list::ClearSelection",
      "shift-j": "issue_list::ExtendSelectionDown",
      "shift-k": "issue_list::ExtendSelectionUp",
      "shift-down": "issue_list::ExtendSelectionDown",
      "shift-up": "issue_list::ExtendSelectionUp",
      "alt-down": "issue_list::MoveDown",
      "alt-up": "issue_list::MoveUp",
      "m": "issue_list::ShowContextMenu",
      "shift-f10": "issue_list::ShowContextMenu"
    }
  },
  {
    "context": "Sidebar",
    "bindings": {
      "j": "sidebar::SelectNext",
      "k": "sidebar::SelectPrevious",
      "down": "sidebar::SelectNext",
      "up": "sidebar::SelectPrevious",
      "enter": "sidebar::Open",
      "shift-j": "sidebar::MoveDown",
      "shift-k": "sidebar::MoveUp",
      "alt-down": "sidebar::MoveDown",
      "alt-up": "sidebar::MoveUp",
      "m": "sidebar::ShowContextMenu",
      "shift-f10": "sidebar::ShowContextMenu",
      "l": "issue_list::Focus",
      "right": "issue_list::Focus",
      "escape": "issue_list::Focus"
    }
  },
  {
    "context": "Archive",
    "bindings": {
      "j": "archive::SelectNext",
      "k": "archive::SelectPrevious",
      "down": "archive::SelectNext",
      "up": "archive::SelectPrevious",
      "m": "archive::ShowContextMenu",
      "shift-f10": "archive::ShowContextMenu",
      "escape": "archive::Close",
      "h": "workspace::FocusSidebar",
      "left": "workspace::FocusSidebar"
    }
  },
  {
    // Not while typing in the title or description.
    "context": "IssueDetail && !TextInput",
    "bindings": {
      "escape": "issue_detail::Close",
      "backspace": "issue_detail::Close",
      "e": "issue_detail::EditTitle",
      "enter": "issue_detail::EditDescription",
      "d": "issue_detail::EditDescription",
      "a": "checklist::AddItem",
      "shift-a": "attachment::Add",
      "cmd-v": "attachment::Paste",
      "s": "issue::SetStatus",
      "l": "issue::AddLabel",
      "shift-l": "issue::RemoveLabel",
      "p": "issue::AddToProject",
      "shift-p": "issue::RemoveFromProject",
      "m": "issue_list::ShowContextMenu",
      "shift-f10": "issue_list::ShowContextMenu",
      "h": "workspace::FocusSidebar",
      "left": "workspace::FocusSidebar"
    }
  },
  {
    "context": "IssueDetail > TextInput",
    "bindings": {
      "escape": "issue_detail::StopEditing",
      "cmd-enter": "issue_detail::StopEditing"
    }
  },
  {
    "context": "ImagePreview",
    "bindings": {
      "right": "image_preview::Next",
      "l": "image_preview::Next",
      "left": "image_preview::Previous",
      "h": "image_preview::Previous",
      "escape": "image_preview::Close",
      "space": "image_preview::Close",
      "r": "attachment::Reveal"
    }
  },
  {
    "context": "NewIssue",
    "bindings": {
      "escape": "issue_list::Focus",
      "down": "issue_list::Focus"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "up": "picker::SelectPrevious",
      "down": "picker::SelectNext",
      "ctrl-p": "picker::SelectPrevious",
      "ctrl-n": "picker::SelectNext",
      "enter": "picker::Confirm",
      "escape": "picker::Dismiss"
    }
  },
  {
    "context": "TextInput",
    "bindings": {
      "backspace": "text_input::Backspace",
      "delete": "text_input::Delete",
      "left": "text_input::Left",
      "right": "text_input::Right",
      "shift-left": "text_input::SelectLeft",
      "shift-right": "text_input::SelectRight",
      "alt-left": "text_input::WordLeft",
      "alt-right": "text_input::WordRight",
      "alt-shift-left": "text_input::SelectWordLeft",
      "alt-shift-right": "text_input::SelectWordRight",
      "alt-backspace": "text_input::DeleteWordLeft",
      "cmd-left": "text_input::Home",
      "cmd-right": "text_input::End",
      "cmd-shift-left": "text_input::SelectHome",
      "cmd-shift-right": "text_input::SelectEnd",
      "home": "text_input::Home",
      "end": "text_input::End",
      "shift-home": "text_input::SelectHome",
      "shift-end": "text_input::SelectEnd",
      "cmd-a": "text_input::SelectAll",
      "cmd-v": "text_input::Paste",
      "cmd-c": "text_input::Copy",
      "cmd-x": "text_input::Cut",
      "enter": "text_input::Enter",
      "ctrl-cmd-space": "text_input::ShowCharacterPalette"
    }
  },
  {
    "context": "TextInput && multiline",
    "bindings": {
      "up": "text_input::Up",
      "down": "text_input::Down",
      "shift-up": "text_input::SelectUp",
      "shift-down": "text_input::SelectDown",
      "cmd-up": "text_input::MoveToStart",
      "cmd-down": "text_input::MoveToEnd",
      "cmd-shift-up": "text_input::SelectToStart",
      "cmd-shift-down": "text_input::SelectToEnd"
    }
  },
  // After the TextInput sections, to take precedence over them.
  {
    "context": "Checklist > TextInput",
    "bindings": {
      "up": "checklist::FocusPrevious",
      "down": "checklist::FocusNext"
    }
  },
  {
    "context": "ChecklistItem > TextInput",
    "bindings": {
      "cmd-enter": "checklist::ToggleItem",
      "alt-up": "checklist::MoveItemUp",
      "alt-down": "checklist::MoveItemDown",
      "cmd-shift-backspace": "checklist::DeleteItem"
    }
  }
]
