// Built-in retro beveled theme for Solilog.
{
  "name": "MMX",
  "appearance": "light",
  "chrome": "bevel",
  "titlebar": "classic",
  "icons": "pixel",
  "radius": 0,
  "shadow": "hard",
  "toolbars": "surface",
  "font_family": "W95FA",
  "colors": {
    "background": "#ffffff",
    "sidebar": "#c0c0c0",
    "surface": "#c0c0c0",
    "input": "#ffffff",
    "tooltip": "#ffffe1",
    "border": "#808080",
    "divider": "#808080",
    "hover": "#dfdfdf",
    "highlight": "#000080",
    "highlight_text": "#ffffff",
    "selection": "#000080",
    "selection_highlight": "#1084d0",
    "selection_text": "#ffffff",
    "text": "#000000",
    "text_muted": "#545454",
    "accent": "#000080",
    "error": "#c00000",
    "review": "#800080",
    "passed": "#008000",
    "text_selection": "#00008040",
    "overlay": "#000000d9",
    "bevel_light": "#ffffff",
    "bevel_highlight": "#dfdfdf",
    "bevel_shadow": "#808080",
    "bevel_dark": "#000000",
    "titlebar_active_start": "#000080",
    "titlebar_active_end": "#1084d0",
    "titlebar_inactive_start": "#808080",
    "titlebar_inactive_end": "#b5b5b5",
    "titlebar_text": "#ffffff",
    "titlebar_inactive_text": "#dfdfdf",
    "glass_highlight": "#ffffff40",
    "glass_glow": "#1084d066",
    "status": {
      "backlog": "#808080",
      "todo": "#404040",
      "in_progress": "#b58900",
      "in_review": "#800080",
      "blocked": "#c00000",
      "done": "#000080",
      "cancelled": "#808080",
      "glyph": "#ffffff"
    },
    "labels": {
      "red": "#b00020",
      "orange": "#b85000",
      "yellow": "#8a6800",
      "green": "#007a24",
      "teal": "#007a7a",
      "blue": "#0048b3",
      "purple": "#6b21a8",
      "pink": "#a81868",
      "gray": "#5a5a5a"
    }
  }
}
