      "in_progress": "#ffb000",
      "in_review": "#33ffd6",
      "blocked": "#ff4d3d",
      "done": "#39ff6a",
      "cancelled": "#1a7332",
      "glyph": "#050c06"
    },
    "labels": {
      "red": "#ff5544",
      "orange": "#ff9922",
      "yellow": "#ffe033",
      "green": "#39ff6a",
      "teal": "#33ffd6",
      "blue": "#4da6ff",
      "purple": "#c080ff",
      "pink": "#ff66cc",
      "gray": "#2aa64a"
    }
