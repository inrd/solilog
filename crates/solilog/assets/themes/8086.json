// Built-in 1980s green-on-black CRT theme with multi-phosphor label/status accents.
{
  "name": "8086",
  "appearance": "dark",
  "chrome": "crt",
  "titlebar": "crt",
  "icons": "pixel",
  "radius": 0,
  "shadow": "hard",
  "toolbars": "plain",
  "font_family": "monospace",
  "colors": {
    "background": "#050c06",
    "sidebar": "#040a05",
    "surface": "#0a170b",
    "input": "#040905",
    "tooltip": "#0a170b",
    "border": "#269942",
    "divider": "#145224",
    "hover": "#0f2914",
    "highlight": "#33ff66",
    "highlight_text": "#050c06",
    "selection": "#1f8f3b",
    "selection_highlight": "#33ff66",
    "selection_text": "#050c06",
    "text": "#39ff6a",
    "text_muted": "#1f8a3c",
    "accent": "#4dff7a",
    "error": "#ff4d3d",
    "review": "#33ffd6",
    "passed": "#39ff6a",
    "text_selection": "#33ff6644",
    "overlay": "#020603f0",
    "bevel_light": "#39ff6a",
    "bevel_highlight": "#269942",
    "bevel_shadow": "#145224",
    "bevel_dark": "#050c06",
    "titlebar_active_start": "#33ff66",
    "titlebar_active_end": "#33ff66",
    "titlebar_inactive_start": "#0a170b",
    "titlebar_inactive_end": "#0a170b",
    "titlebar_text": "#050c06",
    "titlebar_inactive_text": "#1f8a3c",
