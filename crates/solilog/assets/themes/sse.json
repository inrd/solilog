// Built-in early-2000s theme (Windows XP Luna inspired): blue titlebar,
// beige button faces, task-pane blue sidebar.
{
  "name": "SSE",
  "appearance": "light",
  "chrome": "flat",
  "titlebar": "luna",
  "icons": "default",
  "radius": 3,
  "shadow": "soft",
  "toolbars": "surface",
  "colors": {
    "background": "#ffffff",
    "sidebar": "#d6dff7",
    "surface": "#ece9d8",
    "input": "#ffffff",
    "tooltip": "#ffffe1",
    "border": "#7f9db9",
    "divider": "#aca899",
    "hover": "#e3ebfa",
    "highlight": "#316ac5",
    "highlight_text": "#ffffff",
    "selection": "#5a8ad8",
    "selection_highlight": "#244f9e",
    "selection_text": "#ffffff",
    "text": "#000000",
    "text_muted": "#5b6a87",
    "accent": "#215dc6",
    "error": "#c8321e",
    "review": "#7b3fb8",
    "passed": "#2f8f2f",
    "text_selection": "#316ac540",
    "overlay": "#0a1e4ad9",
    "bevel_light": "#ffffff",
    "bevel_highlight": "#f1efe2",
    "bevel_shadow": "#aca899",
    "bevel_dark": "#716f64",
    "titlebar_active_start": "#3d95ff",
    "titlebar_active_end": "#0054e3",
    "titlebar_inactive_start": "#a6bdf0",
    "titlebar_inactive_end": "#7b98df",
    "titlebar_text": "#ffffff",
    "titlebar_inactive_text": "#dfe7f8",
    "glass_highlight": "#ffffff80",
    "glass_glow": "#316ac566",
    "status": {
      "backlog": "#8a8f9c",
      "todo": "#3e64b0",
      "in_progress": "#e08a00",
      "in_review": "#7b3fb8",
      "blocked": "#c8321e",
      "done": "#3a9b2c",
      "cancelled": "#8a8f9c",
      "glyph": "#ffffff"
    },
    "labels": {
      "red": "#c8321e",
      "orange": "#c86400",
      "yellow": "#9a7400",
      "green": "#2f8f2f",
      "teal": "#0e7c86",
      "blue": "#215dc6",
      "purple": "#6f37b0",
      "pink": "#b8327a",
      "gray": "#5b6a87"
    }
  }
}
